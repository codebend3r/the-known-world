{
  "name": "the-known-world",
  "version": "0.4.9",
  "private": true,
  "packageManager": "bun@1.4.4",
  "engines": {
    "node": "^24.16.0"
  },
  "browserslist": [
    "chrome 111",
    "edge 111",
    "firefox 115",
    "safari 16.4"
  ],
  "scripts": {
    "dev": "next dev --port 46642",
    "build": "next build",
    "start": "next start",
    "lint": "bun run --sequential lint:ts lint:scss lint:actions",
    "lint:ts": "oxlint",
    "lint:ts:fix": "oxlint --fix",
    "lint:scss": "gale \"{app,components,styles}/**/*.scss\"",
    "lint:scss:fix": "gale --fix \"{app,components,styles}/**/*.scss\"",
    "lint:actions": "github-actionlint",
    "typecheck": "tsgo --noEmit",
    "test": "bun test --dots --parallel ./ ./.claude",
    "test:watch": "bun test --dots --watch --parallel ./ ./.claude",
    "coverage": "bun test --dots --coverage --parallel ./ ./.claude",
    "format": "oxfmt",
    "format:check": "oxfmt --check",
    "spellcheck": "typos",
    "lint:staged": "lint-staged",
    "prepare": "husky",
    "clean": "rm -rf .next",
    "system-check": "bun run --sequential clean typecheck lint:ts lint:scss lint:actions spellcheck test build"
  },
  "dependencies": {
    "next": "16.4.5",
    "nuqs": "2.10.2",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-svg-pan-zoom": "3.13.1",
    "remark": "15.0.1",
    "remark-html": "16.0.1",
    "yaml": "2.9.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@codebend3r/gale": "0.4.1",
    "@happy-dom/global-registrator": "21.0.4",
    "@ocular-d/typos-bin": "1.52.0",
    "@testing-library/dom": "10.4.2",
    "@testing-library/react": "16.3.3",
    "@types/bun": "1.4.4",
    "@types/node": "24.19.2",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@types/react-svg-pan-zoom": "3.3.9",
    "@typescript/native-preview": "7.0.0-dev.20260707.2",
    "build-meta": "0.1.1",
    "github-actionlint": "1.7.12",
    "husky": "9.1.7",
    "lint-staged": "17.6.0",
    "oxfmt": "0.77.0",
    "oxlint": "1.92.0",
    "sass": "1.108.1",
    "typescript": "6.0.3"
  },
  "trustedDependencies": [
    "@ocular-d/typos-bin",
    "unrs-resolver"
  ],
  "overrides": {
    "postcss": "8.5.28"
  }
}
