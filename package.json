{
  "name": "game-of-thrones-atlas",
  "version": "0.4.1",
  "private": true,
  "packageManager": "bun@1.3.14",
  "engines": {
    "node": ">=24.16"
  },
  "scripts": {
    "dev": "next dev --port 46642",
    "build": "next build",
    "start": "next start",
    "lint:ts": "oxlint --type-aware",
    "lint:ts:fix": "oxlint --type-aware --fix",
    "lint:css": "stylelint \"{app,components,styles}/**/*.scss\"",
    "lint:css:fix": "stylelint --fix \"{app,components,styles}/**/*.scss\"",
    "typecheck": "tsgo --noEmit",
    "test": "bun test --parallel --dots",
    "test:watch": "bun test --parallel --dots --watch",
    "coverage": "bun test --parallel --dots --coverage",
    "format": "oxfmt",
    "format:check": "oxfmt --check",
    "lint:staged": "lint-staged",
    "prepare": "husky",
    "clean": "rm -rf .next",
    "check": "run-p --aggregate-output --print-label typecheck lint:ts lint:css test",
    "system-check": "run-s clean format:check check build"
  },
  "lint-staged": {
    "*.{js,jsx,ts,tsx,mjs,cjs}": [
      "oxlint --fix",
      "oxfmt"
    ],
    "*.{css,scss}": [
      "stylelint --fix",
      "oxfmt"
    ],
    "*.{json,jsonc,json5,md,mdx,yml,yaml,toml,html}": "oxfmt"
  },
  "dependencies": {
    "next": "16.2.12",
    "nuqs": "2.9.2",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "react-svg-pan-zoom": "3.13.1",
    "remark": "15.0.1",
    "remark-html": "16.0.1",
    "yaml": "2.9.0",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@happy-dom/global-registrator": "20.11.1",
    "@testing-library/dom": "10.4.1",
    "@testing-library/react": "16.3.2",
    "@types/bun": "1.3.14",
    "@types/node": "26.1.2",
    "@types/react": "19.2.17",
    "@types/react-dom": "19.2.3",
    "@types/react-svg-pan-zoom": "3.3.9",
    "@typescript/native-preview": "7.0.0-dev.20260707.2",
    "husky": "9.1.7",
    "lint-staged": "17.2.0",
    "npm-run-all2": "9.0.3",
    "oxfmt": "0.61.0",
    "oxlint": "1.76.0",
    "oxlint-tsgolint": "7.0.2001",
    "sass": "1.102.0",
    "stylelint": "17.14.1",
    "stylelint-config-recommended-scss": "17.0.1",
    "typescript": "6.0.3"
  },
  "trustedDependencies": [
    "unrs-resolver"
  ],
  "overrides": {
    "postcss": "8.5.17"
  }
}
