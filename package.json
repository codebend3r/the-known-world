{
  "name": "the-known-world",
  "version": "0.4.3",
  "private": true,
  "packageManager": "bun@1.3.14",
  "engines": {
    "node": ">=24.16"
  },
  "scripts": {
    "dev": "next dev --port 46642",
    "build": "next build",
    "start": "next start",
    "lint:ts": "oxlint --type-aware",
    "lint:ts:fix": "oxlint --type-aware --fix",
    "lint:css": "stylelint \"{app,components,styles}/**/*.scss\"",
    "lint:css:fix": "stylelint --fix \"{app,components,styles}/**/*.scss\"",
    "typecheck": "tsgo --noEmit",
    "test": "bun test --parallel --dots",
    "test:watch": "bun test --parallel --dots --watch",
    "coverage": "bun test --parallel --dots --coverage",
    "format": "oxfmt",
    "format:check": "oxfmt --check",
    "spellcheck": "typos",
    "lint:staged": "lint-staged",
    "prepare": "husky",
    "clean": "rm -rf .next",
    "check": "bun run --parallel typecheck lint:ts lint:css spellcheck test",
    "system-check": "bun run --sequential clean format:check check build"
  },
  "lint-staged": {
    "*.{js,jsx,ts,tsx,mjs,cjs}": [
      "oxlint --fix",
      "oxfmt"
    ],
    "*.{css,scss}": [
      "stylelint --fix",
      "oxfmt"
    ],
    "*.{json,jsonc,json5,md,mdx,yml,yaml,toml,html}": "oxfmt"
  },
  "dependencies": {
    "next": "16.3.5",
    "nuqs": "2.10.1",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-svg-pan-zoom": "3.13.1",
    "remark": "15.0.1",
    "remark-html": "16.0.1",
    "yaml": "2.9.1",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@happy-dom/global-registrator": "20.14.5",
    "@ocular-d/typos-bin": "1.50.2",
    "@testing-library/dom": "10.4.2",
    "@testing-library/react": "16.3.3",
    "@types/bun": "1.4.2",
    "@types/node": "26.6.1",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@types/react-svg-pan-zoom": "3.3.9",
    "@typescript/native-preview": "7.0.0-dev.20260707.2",
    "build-meta": "0.1.1",
    "husky": "9.1.7",
    "lint-staged": "17.5.1",
    "oxfmt": "0.68.0",
    "oxlint": "1.83.0",
    "oxlint-tsgolint": "7.0.2001",
    "sass": "1.104.1",
    "stylelint": "17.15.0",
    "stylelint-config-recommended-scss": "17.0.1",
    "typescript": "6.0.3"
  },
  "trustedDependencies": [
    "@ocular-d/typos-bin",
    "unrs-resolver"
  ],
  "overrides": {
    "postcss": "8.5.28"
  }
}
