    "remark": "15.0.1",
    "remark-html": "16.0.1",
    "yaml": "2.9.0",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@testing-library/dom": "10.4.1",
    "@testing-library/react": "16.3.2",
    "@types/node": "26.1.0",
    "@types/react": "19.2.17",
    "@types/react-dom": "19.2.3",
    "@types/react-svg-pan-zoom": "3.3.9",
    "@vitejs/plugin-react": "6.0.3",
    "@vitest/coverage-istanbul": "4.1.9",
    "eslint": "9.39.4",
    "eslint-config-next": "16.2.10",
