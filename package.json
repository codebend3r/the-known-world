{
  "name": "game-of-thrones-atlas",
  "version": "0.2.7",
  "private": true,
  "engines": {
    "node": ">=24.16"
  },
  "scripts": {
    "dev": "next dev --port 46642",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
