#!/usr/bin/env sh
set -e

echo "Running pre-commit hook"

# Each check is its own statement. Chained with `&&`, `set -e` exempts every
# command but the last, so a failing early check fell through and the hook
# exited 0 — letting broken commits land.

# lint-staged formats and lints only the staged files, then re-stages them.
bun run lint:staged

# Whole-project gates lint-staged can't scope to a file set.
bun run typecheck
bun run test

echo "Pre-commit checks passed"
